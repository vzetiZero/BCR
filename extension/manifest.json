{
  "manifest_version": 3,
  "name": "BCR 3-3 Road Reader",
  "version": "1.2",
  "description": "Doc bang cau Baccarat va so du that tu phien cua ban roi gui ve app BCR tren may nay (http://127.0.0.1:8777). Chi doc, khong dat cuoc, khong gui di dau khac.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["reader.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bcr_http.js", "balance.js", "commands.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": ["http://127.0.0.1:8777/*"],
  "background": {
    "service_worker": "background.js"
  }
}
